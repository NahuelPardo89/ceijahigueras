{
  "name": "ceijahigueras",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.scripts.json --pretty false --noEmit",
    "preview": "vite preview",
    "test:domain": "tsx --test tests/domain.test.ts tests/excel.test.ts tests/migracion.test.ts",
    "test:rules": "firebase emulators:exec --project demo-ceija --only firestore \"tsx --test tests/reglas-y-rac.test.ts && tsx --test tests/migracion-emulador.test.ts\"",
    "test:migracion": "firebase emulators:exec --project demo-ceija --only firestore \"tsx --test tests/migracion-emulador.test.ts\""
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.19.1",
    "globals": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
