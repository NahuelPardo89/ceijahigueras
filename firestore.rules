rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador';
    }

    function isProfessor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Profesor';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidRole(role) {
      return role in ['Administrador', 'Profesor'];
    }

    function hasRequiredCreateFields() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && data.email is string
        && data.email.size() > 0
        && data.displayName is string
        && data.displayName.size() > 0
        && data.createdAt is string;
    }

    function hasValidRoleData() {
      return !request.resource.data.keys().hasAny(['role'])
        || isValidRole(request.resource.data.role);
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    function professorSubjectIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subjectIds;
    }

    function canManageSubject(subjectId) {
      return subjectId in professorSubjectIds();
    }

    function hasValidGradeFields() {
      let data = request.resource.data;
      return data.keys().hasAll(['studentId', 'subjectId', 'planId', 'nota', 'fecha', 'createdAt'])
        && data.studentId is string
        && data.studentId.size() > 0
        && data.subjectId is string
        && data.subjectId.size() > 0
        && data.planId is string
        && data.planId.size() > 0
        && data.nota is string
        && data.nota.size() > 0
        && data.fecha is string
        && data.fecha.size() > 0
        && data.createdAt is string;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());

      allow create: if request.auth != null && (
        (isOwner(uid)
          && request.resource.data.role == 'Profesor'
          && hasRequiredCreateFields())
        ||
        (isAdmin()
          && hasRequiredCreateFields()
          && isValidRole(request.resource.data.role))
      );

      allow update: if request.auth != null && (
        (isOwner(uid) && roleUnchanged() && hasValidRoleData())
        ||
        (isAdmin() && hasValidRoleData())
      );

      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /studyPlans/{planId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /grades/{gradeId} {
      allow read: if request.auth != null && (isAdmin() || (isProfessor() && canManageSubject(resource.data.subjectId)));
      allow create: if request.auth != null && (isAdmin() || (isProfessor() && canManageSubject(request.resource.data.subjectId))) && hasValidGradeFields();
      allow update: if request.auth != null && (isAdmin() || (isProfessor() && canManageSubject(resource.data.subjectId)));
      allow delete: if request.auth != null && (isAdmin() || (isProfessor() && canManageSubject(resource.data.subjectId)));
    }

    function hasValidEquivalenceFields() {
      let data = request.resource.data;
      return data.keys().hasAll(['studentId', 'nombre', 'nota', 'fecha', 'createdAt'])
        && data.studentId is string && data.studentId.size() > 0
        && data.nombre is string && data.nombre.size() > 0
        && data.nota is string && data.nota.size() > 0
        && data.fecha is string && data.fecha.size() > 0
        && data.createdAt is string;
    }

    match /equivalences/{eqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && hasValidEquivalenceFields();
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }
  }
}
